# ========================================================
# Intelligent Route Optimization System - Environment Configuration
# ========================================================

# App Settings
PROJECT_NAME="Intelligent Route Optimization & Navigation System"
VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Database Settings
# For local dev without Docker, SQLite is automatically supported (sqlite:///./route_opt.db)
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/route_optimization
DATABASE_URL=sqlite:///./route_opt.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=route_optimization
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & Authentication
SECRET_KEY=super-secret-development-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# DSA Engine Backend Selection (auto, cpp, python)
# 'auto' prefers compiled C++ pybind11 module if present, falls back gracefully to high-perf Python engine
DSA_ENGINE_MODE=auto

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

